// Schema inicial — ver CONTEXT.md §7 pra intenção original de cada tabela.
// Nomes de campo em camelCase (convenção Prisma); os nomes do §7 em
// snake_case mapeiam 1:1 conceitualmente.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String   @id @default(cuid())
  discordId        String   @unique
  discordUsername  String
  discordAvatarUrl String?
  riotPuuid        String?  @unique
  riotName         String?
  riotTag          String?
  riotRegion       String? // affinity retornada pela HenrikDev (na/eu/ap/kr/latam/br) — necessária pro sync
  funcaoPreferida  String?
  createdAt        DateTime @default(now())

  // Perfil editável pelo próprio dono, em qualquer lugar do app que mostre
  // esse usuário (não é por-equipe — v1 é 1 equipe por usuário, então dá no
  // mesmo, ver LAUNCH.md/decisão de 01/09/2026). `null` cai no fallback de
  // sempre: displayName ?? riotName ?? discordUsername (nome),
  // avatarUrl ?? discordAvatarUrl (imagem).
  displayName String?
  avatarUrl   String? // upload próprio, data URL comprimida no navegador — mesmo padrão de Spot.imagens

  // Tema v2 — customizável em runtime (ver design_handoff_callout v2). Cor de
  // ação também colore valores positivos (vitória etc); cor negativa é
  // independente disso, só pra derrotas/valores negativos — se fossem a
  // mesma, não daria pra diferenciar vitória de derrota na tela.
  themeAccent   String @default("#EF4958")
  themeNegative String @default("#EF4958")
  themeGlow     Int    @default(70) // 0-100
  themeMode     String @default("dark") // "dark" | "light" — ver ThemeMode em @callout/shared

  // Admin da PLATAFORMA (não da equipe — ver MembroEquipe.isAdmin pra
  // isso). Só quem tem isso true vê o switch de Administrador e pode
  // editar placar de competição. Setado direto no banco, não tem UI pra
  // virar admin sozinho.
  isAdmin Boolean @default(false)

  membrosEquipe    MembroEquipe[]
  equipesComoDono  Equipe[]     @relation("EquipeDono")
  strategiesFeitas Strategy[]  @relation("StrategyAuthor")
  spotsFeitos     Spot[]       @relation("SpotAuthor")
  comments        Comment[]
  strategyUsagesMarcadas StrategyUsage[] @relation("StrategyUsageMarkedBy")

  @@map("users")
}

model MapAsset {
  id          String  @id @default(cuid())
  uuid        String  @unique
  nome        String
  displayIcon String?
  xMultiplier Float
  yMultiplier Float
  xScalar     Float
  yScalar     Float
  callouts    Json

  matches    Match[]
  strategies Strategy[]
  spots      Spot[]

  @@map("maps")
}

model AgentAsset {
  id          String  @id @default(cuid())
  uuid        String  @unique
  nome        String
  funcao      String?
  displayIcon String?
  cor         String?

  @@map("agents")
}

model Match {
  id         String   @id // match_id da HenrikDev — partida antiga nunca muda, ver CONTEXT.md §8
  mapId      String?
  map        MapAsset? @relation(fields: [mapId], references: [id])
  modo       String
  startedAt  DateTime
  durationMs Int
  rawJson    Json
  createdAt  DateTime @default(now())

  players MatchPlayer[]
  strategyUsages StrategyUsage[]

  @@map("matches")
}

model MatchPlayer {
  id             String @id @default(cuid())
  matchId        String
  match          Match  @relation(fields: [matchId], references: [id], onDelete: Cascade)
  puuid          String
  teamId         String // team_id bruto da HenrikDev (ex.: "Red"/"Blue")
  won            Boolean
  agentUuid      String?
  agentName      String
  name           String
  tag            String
  roundsPlayed   Int
  acs            Int
  kills          Int
  deaths         Int
  assists        Int
  headshots      Int
  bodyshots      Int
  legshots       Int
  damageDealt    Int
  damageReceived Int
  // Delta de RR (last_change do mmr-history) só é gravado pro dono da conta
  // que disparou o sync — a HenrikDev só devolve RR pra quem você pede, não
  // pros outros jogadores da partida. Nulo até o dono daquela conta
  // sincronizar (ou pra partidas de modo sem RR, tipo Unrated/Deathmatch).
  // Gravado no momento do sync porque o endpoint mmr-history só cobre as
  // ~20 partidas ranqueadas mais recentes — depois disso o dado some da API
  // pra sempre, então precisa capturar cedo.
  rr             Int?

  @@unique([matchId, puuid])
  @@index([puuid])
  @@map("match_players")
}

// Nome interno "Equipe" (era "Team") — rename de 2026-09-01. Tabela física
// continua "teams"/"team_members" (@map/@@map abaixo) — decoupled de
// propósito, então esse rename não precisou de migration nenhuma.
model Equipe {
  id     String @id @default(cuid())
  nome   String
  donoId String @map("ownerId")
  dono   User   @relation("EquipeDono", fields: [donoId], references: [id])
  // Código curto pra convidar gente pra equipe (POST /equipes/entrar).
  // Gerado na criação (ver gerarCodigoConvite em lib/equipe.ts) — Prisma não
  // tem default de string aleatória, então é responsabilidade do código de
  // aplicação, com retry em colisão (P2002).
  codigoConvite String  @unique @map("inviteCode")
  imagemUrl     String? // logo/imagem da equipe — data URL comprimida no navegador, mesmo padrão de Spot.imagens
  descricao     String? // texto livre, editável só por admin (ver routes/equipe.ts)

  membros    MembroEquipe[]
  strategies Strategy[]
  spots      Spot[]

  @@map("teams")
}

model MembroEquipe {
  id       String @id @default(cuid())
  equipeId String @map("teamId")
  equipe   Equipe @relation(fields: [equipeId], references: [id], onDelete: Cascade)
  // Um usuário só pode estar em uma equipe por vez (v1 — ver LAUNCH.md/decisão
  // de 01/09/2026). Sem isso, "qual é a minha equipe" vira ambíguo em toda
  // rota que hoje assume uma só.
  userId String @unique
  user   User   @relation(fields: [userId], references: [id])
  funcoes         String[] @default([]) // até 2 — controlador | duelista | iniciador | sentinela | flex
  nota            String?  // recado social do card ("Segura o mapa inteiro sozinho..."), editável pelo grupo
  mainAgentUuids  String[] @default([]) // até 3, uuid do AgentAsset — editável pelo grupo, igual funcoes/nota
  // "jogador" | "treinador_principal" | "treinador_assistente" — validado
  // via Zod na rota, não aqui (mesmo padrão de side/lado/tipo no resto do
  // schema). Só jogador tem sentido ter Riot ID vinculado/estatística.
  cargo   String  @default("jogador")
  // Dono da equipe (Equipe.donoId) é sempre admin, de forma permanente — não
  // é removível nem rebaixável (decisão de 01/09/2026, v1: sem transferência
  // de posse ainda). isAdmin aqui cobre os admins ALÉM do dono, que o dono
  // pode promover via PATCH /equipe/membros/:userId/admin.
  isAdmin Boolean @default(false)
  // "Data de entrada na equipe" — não existia antes desse campo, então
  // membros anteriores a 01/09/2026 mostram a data da migration, não a
  // entrada real (não tem como recuperar isso, nunca foi registrado).
  createdAt DateTime @default(now())

  @@unique([equipeId, userId])
  @@map("team_members")
}

model Strategy {
  id          String   @id @default(cuid())
  equipeId    String   @map("teamId")
  equipe      Equipe   @relation(fields: [equipeId], references: [id], onDelete: Cascade)
  mapId       String
  map         MapAsset @relation(fields: [mapId], references: [id])
  lado        String // ATK | DEF
  titulo      String
  descricao   String   @default("")
  criadoPorId String
  criadoPor   User     @relation("StrategyAuthor", fields: [criadoPorId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  items StratItem[]
  usages StrategyUsage[]

  @@map("strategies")
}

// Marcação manual de "usamos essa estratégia nessa partida" — não tem
// como detectar isso automaticamente (a HenrikDev não sabe o que
// combinamos antes do round), então é opt-in, feito por alguém do time
// depois da partida. `won` fica denormalizado na hora de marcar (o
// resultado da partida pra quem marcou) — evita ter que recalcular
// olhando `MatchPlayer` de novo toda vez que a Strategy DTO é montada.
model StrategyUsage {
  id          String   @id @default(cuid())
  matchId     String
  match       Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  strategyId  String
  strategy    Strategy @relation(fields: [strategyId], references: [id], onDelete: Cascade)
  won         Boolean
  marcadoPorId String
  marcadoPor  User     @relation("StrategyUsageMarkedBy", fields: [marcadoPorId], references: [id])
  createdAt   DateTime @default(now())

  @@unique([matchId, strategyId])
  @@map("strategy_usages")
}

model StratItem {
  id         String   @id @default(cuid())
  strategyId String
  strategy   Strategy @relation(fields: [strategyId], references: [id], onDelete: Cascade)
  tipo       String // agent | smoke | flash | molly | arrow | line
  x          Float
  y          Float
  agentUuid  String?
  payload    Json?

  @@map("strat_items")
}

// Simplificado de propósito: sem coordenadas de mapa nem vídeo — vira um
// catálogo filtrável (mapa/agente/lado) com descrição e até 3 imagens
// (validado na rota, não aqui). Imagens guardadas como data URL (base64)
// direto na coluna — sem storage de blob externo configurado ainda, e pro
// tamanho do grupo (<10 usuários) isso é suficiente por ora.
model Spot {
  id          String   @id @default(cuid())
  equipeId    String   @map("teamId")
  equipe      Equipe   @relation(fields: [equipeId], references: [id], onDelete: Cascade)
  mapId       String
  map         MapAsset @relation(fields: [mapId], references: [id])
  agentUuid   String
  side        String // ATK | DEF
  descricao   String
  imagens     String[]
  link        String? // YouTube ou Instagram, validado na rota
  criadoPorId String
  criadoPor   User     @relation("SpotAuthor", fields: [criadoPorId], references: [id])
  createdAt   DateTime @default(now())

  @@map("spots")
}

// Chaveamento de competições externas (VCT, Game Changers etc.) que o time
// acompanha — não são partidas jogadas por vocês. Editado à mão pelo admin
// pela tela de Competições conforme os jogos acontecem; ver CompeticaoTime
// e Confronto abaixo.
model Competicao {
  id          String   @id
  nome        String
  formato     String
  categorias  String[] // mista | inclusiva | feminina | aberta
  fase        String
  status      String // agendada | em_andamento | encerrada
  linkTwitch  String?
  linkYoutube String?

  times      CompeticaoTime[]
  confrontos Confronto[]

  @@map("competicoes")
}

model CompeticaoTime {
  id           String     @id @default(cuid())
  competicaoId String
  competicao   Competicao @relation(fields: [competicaoId], references: [id], onDelete: Cascade)
  timeId       String // "loud", "fur" — chave lógica referenciada em Confronto.ladoA/ladoB
  nome         String
  sigla        String
  cor          String

  @@unique([competicaoId, timeId])
  @@map("competicao_times")
}

// ladoA/ladoB guardam { tipo: "time", timeId } ou { tipo: "vencedor"|"perdedor",
// confrontoId } — resolvido em runtime (ver resolverLado em @callout/shared),
// então atualizar o placar de um confronto já avança quem depende dele sem
// precisar editar mais nada.
model Confronto {
  id           String     @id @default(cuid())
  competicaoId String
  competicao   Competicao @relation(fields: [competicaoId], references: [id], onDelete: Cascade)
  confrontoId  String // "P1", "A5" — chave lógica referenciada por vencedor/perdedor
  chave        String // superior | inferior | final
  // String "ingênua" tipo "2026-08-27T18:00", sem timezone — o app inteiro
  // assume horário de Brasília e interpreta isso como hora local do
  // navegador. DateTime/timestamptz normalizaria pra UTC e deslocaria o
  // horário mostrado; de propósito não usamos isso aqui.
  data         String
  status       String // encerrada | ao_vivo | agendada
  ladoA        Json
  ladoB        Json
  placarA      Int?
  placarB      Int?

  @@unique([competicaoId, confrontoId])
  @@map("confrontos")
}

model Comment {
  id           String   @id @default(cuid())
  entidadeTipo String // match | strategy | spot
  entidadeId   String
  userId       String
  user         User     @relation(fields: [userId], references: [id])
  texto        String
  createdAt    DateTime @default(now())

  @@index([entidadeTipo, entidadeId])
  @@map("comments")
}
