// Schema inicial — ver CONTEXT.md §7 pra intenção original de cada tabela.
// Nomes de campo em camelCase (convenção Prisma); os nomes do §7 em
// snake_case mapeiam 1:1 conceitualmente.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String   @id @default(cuid())
  discordId        String   @unique
  discordUsername  String
  discordAvatarUrl String?
  riotPuuid        String?  @unique
  riotName         String?
  riotTag          String?
  riotRegion       String? // affinity retornada pela HenrikDev (na/eu/ap/kr/latam/br) — necessária pro sync
  funcaoPreferida  String?
  createdAt        DateTime @default(now())

  // Tema v2 — customizável em runtime (ver design_handoff_callout v2). Cor de
  // ação e cor "positiva" são independentes de propósito: se fossem a mesma,
  // vermelho passaria a significar vitória.
  themeAccent      String  @default("#EF4958")
  themePositive    String  @default("#18AAB7")
  themeGlow        Int     @default(70) // 0-100
  themeTintedCards Boolean @default(true)

  teamMemberships TeamMember[]
  ownedTeams      Team[]       @relation("TeamOwner")
  strategiesFeitas Strategy[]  @relation("StrategyAuthor")
  spotsFeitos     Spot[]       @relation("SpotAuthor")
  comments        Comment[]
  strategyUsagesMarcadas StrategyUsage[] @relation("StrategyUsageMarkedBy")

  @@map("users")
}

model MapAsset {
  id          String  @id @default(cuid())
  uuid        String  @unique
  nome        String
  displayIcon String?
  xMultiplier Float
  yMultiplier Float
  xScalar     Float
  yScalar     Float
  callouts    Json

  matches    Match[]
  strategies Strategy[]
  spots      Spot[]

  @@map("maps")
}

model AgentAsset {
  id          String  @id @default(cuid())
  uuid        String  @unique
  nome        String
  funcao      String?
  displayIcon String?
  cor         String?

  @@map("agents")
}

model Match {
  id         String   @id // match_id da HenrikDev — partida antiga nunca muda, ver CONTEXT.md §8
  mapId      String?
  map        MapAsset? @relation(fields: [mapId], references: [id])
  modo       String
  startedAt  DateTime
  durationMs Int
  rawJson    Json
  createdAt  DateTime @default(now())

  players MatchPlayer[]
  strategyUsages StrategyUsage[]

  @@map("matches")
}

model MatchPlayer {
  id             String @id @default(cuid())
  matchId        String
  match          Match  @relation(fields: [matchId], references: [id], onDelete: Cascade)
  puuid          String
  teamId         String // team_id bruto da HenrikDev (ex.: "Red"/"Blue")
  won            Boolean
  agentUuid      String?
  agentName      String
  name           String
  tag            String
  roundsPlayed   Int
  acs            Int
  kills          Int
  deaths         Int
  assists        Int
  headshots      Int
  bodyshots      Int
  legshots       Int
  damageDealt    Int
  damageReceived Int

  @@unique([matchId, puuid])
  @@index([puuid])
  @@map("match_players")
}

model Team {
  id      String @id @default(cuid())
  nome    String
  ownerId String
  owner   User   @relation("TeamOwner", fields: [ownerId], references: [id])

  members    TeamMember[]
  strategies Strategy[]

  @@map("teams")
}

model TeamMember {
  id      String  @id @default(cuid())
  teamId  String
  team    Team    @relation(fields: [teamId], references: [id], onDelete: Cascade)
  userId  String
  user    User    @relation(fields: [userId], references: [id])
  funcao  String? // controlador | duelista | iniciador | sentinela
  nota    String? // recado social do card ("Segura o mapa inteiro sozinho..."), editável pelo grupo

  @@unique([teamId, userId])
  @@map("team_members")
}

model Strategy {
  id          String   @id @default(cuid())
  teamId      String
  team        Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  mapId       String
  map         MapAsset @relation(fields: [mapId], references: [id])
  lado        String // ATK | DEF
  titulo      String
  descricao   String   @default("")
  criadoPorId String
  criadoPor   User     @relation("StrategyAuthor", fields: [criadoPorId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  items StratItem[]
  usages StrategyUsage[]

  @@map("strategies")
}

// Marcação manual de "usamos essa estratégia nessa partida" — não tem
// como detectar isso automaticamente (a HenrikDev não sabe o que
// combinamos antes do round), então é opt-in, feito por alguém do time
// depois da partida. `won` fica denormalizado na hora de marcar (o
// resultado da partida pra quem marcou) — evita ter que recalcular
// olhando `MatchPlayer` de novo toda vez que a Strategy DTO é montada.
model StrategyUsage {
  id          String   @id @default(cuid())
  matchId     String
  match       Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  strategyId  String
  strategy    Strategy @relation(fields: [strategyId], references: [id], onDelete: Cascade)
  won         Boolean
  marcadoPorId String
  marcadoPor  User     @relation("StrategyUsageMarkedBy", fields: [marcadoPorId], references: [id])
  createdAt   DateTime @default(now())

  @@unique([matchId, strategyId])
  @@map("strategy_usages")
}

model StratItem {
  id         String   @id @default(cuid())
  strategyId String
  strategy   Strategy @relation(fields: [strategyId], references: [id], onDelete: Cascade)
  tipo       String // agent | smoke | flash | molly | arrow | line
  x          Float
  y          Float
  agentUuid  String?
  payload    Json?

  @@map("strat_items")
}

// Simplificado de propósito: sem coordenadas de mapa nem vídeo — vira um
// catálogo filtrável (mapa/agente/lado) com descrição e até 3 imagens
// (validado na rota, não aqui). Imagens guardadas como data URL (base64)
// direto na coluna — sem storage de blob externo configurado ainda, e pro
// tamanho do grupo (<10 usuários) isso é suficiente por ora.
model Spot {
  id          String   @id @default(cuid())
  mapId       String
  map         MapAsset @relation(fields: [mapId], references: [id])
  agentUuid   String
  side        String // ATK | DEF
  descricao   String
  imagens     String[]
  link        String? // YouTube ou Instagram, validado na rota
  criadoPorId String
  criadoPor   User     @relation("SpotAuthor", fields: [criadoPorId], references: [id])
  createdAt   DateTime @default(now())

  @@map("spots")
}

model Comment {
  id           String   @id @default(cuid())
  entidadeTipo String // match | strategy | spot
  entidadeId   String
  userId       String
  user         User     @relation(fields: [userId], references: [id])
  texto        String
  createdAt    DateTime @default(now())

  @@index([entidadeTipo, entidadeId])
  @@map("comments")
}
