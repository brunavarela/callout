# Postgres (Neon) — connection string do dashboard do Neon
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Discord OAuth2 (https://discord.com/developers/applications)
DISCORD_CLIENT_ID=""
DISCORD_CLIENT_SECRET=""
DISCORD_REDIRECT_URI="http://localhost:4025/auth/discord/callback"
# Servidor do grupo — só membros dele podem entrar
DISCORD_GUILD_ID=""

# HenrikDev API (https://api.henrikdev.xyz/dashboard/)
HENRIKDEV_API_KEY=""

# Sessão
SESSION_SECRET=""

# API — porta escolhida pra não colidir com outros projetos locais (a 3333 já
# está em uso por outro projeto nesta máquina)
PORT=4025
WEB_ORIGIN="http://localhost:5290"

# Web (apps/web usa prefixo VITE_)
VITE_API_URL="http://localhost:4025"
