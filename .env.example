# Postgres (Neon) — connection string do dashboard do Neon
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Resend (https://resend.com — tier gratuito, 3.000 emails/mês). EMAIL_FROM
# precisa ser um endereço no domínio verificado na Resend.
RESEND_API_KEY=""
EMAIL_FROM="Callout <naoresponda@callout.app.br>"

# HenrikDev API (https://api.henrikdev.xyz/dashboard/)
HENRIKDEV_API_KEY=""

# Sessão
SESSION_SECRET=""

# API — porta escolhida pra não colidir com outros projetos locais (a 3333 já
# está em uso por outro projeto nesta máquina)
PORT=4025
WEB_ORIGIN="http://localhost:5290"

# Error tracking (Sentry, https://sentry.io — tier gratuito). Opcional: sem
# DSN, Sentry.init() é um no-op tanto no backend quanto no front (não
# quebra nada rodar sem configurar isso). Criar um projeto Node no Sentry
# pro DSN de baixo, e um projeto React pro de cima.
SENTRY_DSN=""

# Web (apps/web usa prefixo VITE_)
VITE_API_URL="http://localhost:4025"
VITE_SENTRY_DSN=""
